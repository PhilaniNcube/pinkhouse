# The Pink House
NEXT_PUBLIC_SITE_URL=https://www.thepinkhouse.co.zw
PAYLOAD_SECRET=replace-with-a-long-random-string

# Turso (libSQL). For local development a file database is used.
# Production example: libsql://pinkhouse-mrsncube.turso.io
DATABASE_URI=file:./pinkhouse.db
DATABASE_AUTH_TOKEN=

# Initial admin account used by `npm run seed`
SEED_ADMIN_EMAIL=mrs.ncube@thepinkhouse.co.zw
SEED_ADMIN_PASSWORD=change-this-before-deploying
SEED_ADMIN_NAME=Mrs Ncube

# Cloudflare R2 (S3-compatible). When these are empty, media is stored in public/media.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=

# OTA iCal sync (inbound). Paste the private export links from each provider.
# An empty BOOKING_ICAL_URL is skipped, so adding Booking.com later only needs
# this value (or a source in Payload admin).
AIRBNB_ICAL_URL=
BOOKING_ICAL_URL=

# Protects /api/cron/sync-ical. Vercel Cron sends this as a Bearer token when
# the variable is present in the project.
CRON_SECRET=

# Optional. When set, /api/calendar/export.ics requires ?token=<value>.
# Leave empty to keep the outbound feed public.
CALENDAR_EXPORT_TOKEN=

# Resend & React Email notifications (PayloadCMS email adapter + reservation & enquiry alerts)
RESEND_API_KEY=
RESEND_FROM_EMAIL=notifications@thepinkhouse.co.zw
RESEND_FROM_NAME="The Pink House"
ADMIN_NOTIFICATION_EMAILS=ncbphi001@gmail.com,pnavaya@yahoo.co.uk,everncube@gmail.com
