# The Pink House
NEXT_PUBLIC_SITE_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-a-long-random-string

# Turso (libSQL). For local development a file database is used.
# Production example: libsql://pinkhouse-mrsncube.turso.io
DATABASE_URI=file:./pinkhouse.db
DATABASE_AUTH_TOKEN=

# Initial admin account used by `npm run seed`
SEED_ADMIN_EMAIL=mrs.ncube@thepinkhouse.co.zw
SEED_ADMIN_PASSWORD=change-this-before-deploying
SEED_ADMIN_NAME=Mrs Ncube

# Cloudflare R2 (S3-compatible). When these are empty, media is stored in public/media.
R2_BUCKET=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_URL=
